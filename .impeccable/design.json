    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "field",
      "description": "BrandPrimitives labeled search with its 46px field and real SVG icon.",
      "html": "<div class=\"ds-field\"><label for=\"ds-parts-search\">Search parts</label><div class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input id=\"ds-parts-search\" type=\"search\" placeholder=\"Part name or model\"></div></div>",
      "css": ".ds-field{font:400 15px/1.6 Inter,sans-serif}.ds-field label{display:block;margin-bottom:6px;color:var(--text,#242832);font-size:14px;font-weight:600}.ds-search{position:relative}.ds-search svg{position:absolute;left:12px;bottom:14px;color:var(--text-secondary,#565e6b)}.ds-search input{box-sizing:border-box;width:100%;min-height:46px;padding:10px 12px 10px 40px;border:1px solid var(--input-border,#8b95a6);border-radius:8px;background:var(--surface,#fff);color:var(--text,#242832);font:inherit}.ds-search input:focus-visible{border-color:var(--accent-hover,#a34110);outline:3px solid var(--focus-ring,#a34110);outline-offset:3px}.ds-search input[aria-invalid=true]{border-color:var(--danger,#ac1c2b)}@media(max-width:639px){.ds-search input{font-size:16px}}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:.01ms!important;animation-duration:.01ms!important;}}"
    },
    {
      "name": "Operations Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Navy workspace navigation with translucent selected row and orange inset marker.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Operations\"><button type=\"button\" aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Dashboard</button><button type=\"button\">Inventory</button></nav>",
      "css": ".ds-nav{--focus-ring:var(--hot-orange,#ff8a1f);padding:16px 12px;background:var(--racing-navy,#111c3d);font:500 14px/1.5 Inter,sans-serif}.ds-nav button{position:relative;display:flex;align-items:center;gap:12px;width:100%;min-height:42px;margin:4px 0;padding:0 12px;border:0;border-radius:6px;background:transparent;color:#b4bdcc;text-align:left;font:inherit;cursor:pointer;transition:background-color 200ms,color 200ms}.ds-nav button:hover{background:rgba(255,255,255,.06);color:#fff}.ds-nav button[aria-current=page]{background:#ffffff0d;color:#fff}.ds-nav button[aria-current=page]::before{content:\"\";position:absolute;inset:8px auto 8px 0;width:2px;border-radius:0 999px 999px 0;background:var(--performance-orange,#f36a21)}.ds-nav button[aria-current=page] svg{color:var(--hot-orange,#ff8a1f)}.ds-nav button:focus-visible {outline:3px solid var(--focus-ring,#a34110);outline-offset:3px;}@media(pointer:coarse){.ds-nav button{min-height:44px}}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:.01ms!important;animation-duration:.01ms!important;}}"
    },
