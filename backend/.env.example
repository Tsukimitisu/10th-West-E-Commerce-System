
DATABASE_URL=
SUPABASE_DB_URL=

TEST_DATABASE_URL=


DB_SSL_MODE=
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000


DB_READ_MODE=postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REST_TIMEOUT_MS=10000
DB_READ_FALLBACK_TTL_MS=600000

# Server Configuration
PORT=5000
NODE_ENV=development

JWT_SECRET=
SESSION_SECRET=
CSRF_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
SESSION_STORE=postgres
SESSION_TTL=7d
SESSION_CLEANUP_INTERVAL_MS=300000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_COOKIE_SAME_SITE=lax

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Additional production entries must be comma-separated absolute HTTPS origins.
CORS_ALLOWED_ORIGINS=

# Copy production overrides from DEPLOYMENT.md into Render's environment.
# PORT is supplied by Render; 5000 is only the local default.
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

# Prices are VAT-inclusive by default. Set only if tax must be added at checkout.
CHECKOUT_TAX_RATE=0

# Email Configuration (Gmail or any SMTP). Leave empty until configured.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Legacy aliases currently read by the application mailers.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
SUPPORT_EMAIL=

# =========================
# J&T Luzon-Only Hybrid Logistics
# =========================
SHIPPING_PROVIDER=internal
SHIPPING_FEE_PROVIDER=internal
SHIPPING_COVERAGE=luzon_only

COURIER_PROVIDER=jnt
WAYBILL_PROVIDER=manual
TRACKING_PROVIDER=manual

JNT_COURIER_NAME=J&T Express
JNT_DEFAULT_SERVICE=standard
JNT_TRACKING_BASE_URL=https://www.jtexpress.ph/trajectoryQuery?flag=1&waybillNo=

# =========================
# Shop Origin / Pickup Location
# Replace with the real 10th West shop location
# =========================
SHOP_ORIGIN_NAME=10th West Motorcycle Shop
SHOP_ORIGIN_CITY=Malabon
SHOP_ORIGIN_PROVINCE=Metro Manila
SHOP_ORIGIN_REGION=NCR
SHOP_ORIGIN_COUNTRY=Philippines

# Optional if you want coordinates later
SHOP_ORIGIN_LAT=
SHOP_ORIGIN_LNG=

# =========================
# Luzon Shipping Fee Rules
# =========================
METRO_MANILA_SHIPPING_FEE=100
LUZON_SHIPPING_FEE=150
DEFAULT_SHIPPING_FEE=120
FREE_SHIPPING_THRESHOLD=3000

# =========================
# Actual Weight Rules Only
# No volumetric weight
# =========================
SMALL_PACKAGE_MAX_KG=1
MEDIUM_PACKAGE_MAX_KG=3
LARGE_PACKAGE_MAX_KG=5

MEDIUM_PACKAGE_SURCHARGE=50
LARGE_PACKAGE_SURCHARGE=100
OVERSIZED_PACKAGE_SURCHARGE=150

# =========================
# Distance-Based Shipping Rules
# Internal estimated distance only
# =========================
DISTANCE_PROVIDER=internal
DISTANCE_CALCULATION=shop_to_customer_place

DISTANCE_FREE_KM=5
DISTANCE_RATE_PER_KM=5
DISTANCE_SURCHARGE_ROUNDING=ceil

NEAR_DISTANCE_MAX_KM=10
MID_DISTANCE_MAX_KM=50
FAR_DISTANCE_MAX_KM=150

NEAR_DISTANCE_SURCHARGE=0
MID_DISTANCE_SURCHARGE=30
FAR_DISTANCE_SURCHARGE=80
VERY_FAR_DISTANCE_SURCHARGE=120

MAX_LUZON_DELIVERY_DISTANCE_KM=300

# Background cleanup workers
RESERVATION_CLEANUP_INTERVAL_MS=60000
MAINTENANCE_CLEANUP_INTERVAL_MS=300000
MAINTENANCE_CLEANUP_DISABLED=false

# OAuth providers. Leave empty until the provider app is configured.
# Google aliases GOOGLE_AUTH_* and GOOGLE_OAUTH_* are also accepted, but the
# canonical names below are preferred.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary Storage (durable media storage for all uploads: products, avatars, reviews)
# Leave empty to keep uploads blocked by configuration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder namespace (recommended per environment, e.g. 10th-west-moto-prod)
CLOUDINARY_UPLOAD_ROOT=10th-west-moto


PAYMENT_PROVIDER=paymongo
PAYMONGO_MODE=test
PAYMONGO_API_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SUCCESS_URL=http://localhost:5173/payment/success
PAYMONGO_FAILED_URL=http://localhost:5173/payment/failed
PAYMONGO_CANCEL_URL=http://localhost:5173/payment/cancelled
PAYMONGO_ALLOWED_METHODS=gcash
PAYMONGO_CURRENCY=PHP

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# Phone verification. Requires a funded Semaphore account and approved sender.
PHONE_VERIFICATION_PROVIDER=semaphore
PHONE_VERIFICATION_ENABLED=false
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=10THWEST
OTP_EXPIRY_MINUTES=5
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_LIMIT=5
OTP_DEBUG_LOG_CODE=false

# Optional invoice overrides; otherwise use saved Store Settings.
BUSINESS_NAME=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
